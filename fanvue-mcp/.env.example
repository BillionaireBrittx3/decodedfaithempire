# Fanvue MCP server configuration.
# Copy to `.env` and fill in — never commit real tokens.

# ── Recommended: OAuth auto-refresh ─────────────────────────────────────────
# From the app you register in the Fanvue Developer area, plus a refresh token
# obtained from the OAuth flow (offline_access scope). The server discovers the
# token endpoint via OIDC and refreshes access tokens automatically.
FANVUE_OAUTH_CLIENT_ID=
FANVUE_OAUTH_CLIENT_SECRET=
FANVUE_OAUTH_REFRESH_TOKEN=
# Optional — defaults to https://auth.fanvue.com
FANVUE_OAUTH_ISSUER_BASE_URL=https://auth.fanvue.com

# ── Alternative: static access token ────────────────────────────────────────
# Simpler but expires; you'll have to update it manually. Used only if the
# OAuth variables above are not all set.
# FANVUE_ACCESS_TOKEN=

# ── Optional API settings ───────────────────────────────────────────────────
# Pin the API version (date string). Defaults to 2025-06-26.
# A request returning HTTP 410 includes the nextVersion to set here.
FANVUE_API_VERSION=2025-06-26

# Override the base URL (defaults to https://api.fanvue.com).
# FANVUE_BASE_URL=https://api.fanvue.com
