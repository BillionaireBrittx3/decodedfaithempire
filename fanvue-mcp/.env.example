# Fanvue MCP server configuration.
# Copy to `.env` and fill in — never commit real tokens.

# Required: OAuth 2.0 access token for the creator account.
FANVUE_ACCESS_TOKEN=

# Optional: pin the API version (date string). Defaults to 2025-06-26.
# If a request returns HTTP 410, the error message includes the nextVersion to set here.
FANVUE_API_VERSION=2025-06-26

# Optional: override the base URL (defaults to https://api.fanvue.com).
# FANVUE_BASE_URL=https://api.fanvue.com
